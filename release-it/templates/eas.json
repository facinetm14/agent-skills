{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "APP_VARIANT": "development" },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "channel": "preview",
      "env": { "APP_VARIANT": "preview" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": { "APP_VARIANT": "production" },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "beta": {
      "android": { "track": "alpha", "releaseStatus": "completed" },
      "ios": { "ascAppId": "YOUR_APP_STORE_CONNECT_APP_ID" }
    },
    "production": {
      "android": { "track": "production", "releaseStatus": "inProgress", "rollout": 0.05 },
      "ios": { "ascAppId": "YOUR_APP_STORE_CONNECT_APP_ID" }
    }
  }
}
